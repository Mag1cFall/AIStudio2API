# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# API 试用页 HTML 预览的监听地址，端口与 LISTEN_ADDR 不同
PREVIEW_LISTEN_ADDR=127.0.0.1:2050

# 本地 API 认证密钥，多个 key 用逗号分隔
PROXY_API_KEY=

# 管理程序启动后自动启动生成服务，修改后重启程序生效
AUTO_START=false

# 保存公开 API 的 POST 请求与响应正文，各截断到 64 KiB，只保留最近 1000 条，保存后立即生效
REQUEST_BODY_LOG=false

# 同时把服务日志写入 runtime/logs/，单文件 10 MB 轮转，保存后立即生效
LOG_FILE=true

# 日志目录总量上限（MB），超出时删除最旧的文件，不小于 20
LOG_MAX_TOTAL_MB=500

# 管理控制台登录，修改后重启程序生效
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理，多个代理用逗号分隔组成代理池
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=30m

# 常驻预热账户数
WARM_WORKER_LIMIT=5

# 高峰期最多同时运行的 Worker 数
MAX_ACTIVE_WORKERS=10

# 同时冷启动的 Camoufox Worker 数，预热与按需扩容共用；WAA_BACKEND=spidermonkey 时不限制
WARM_STARTUP_CONCURRENCY=5

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# 生成请求使用的上游通道：playground、build（旧通道，上游已停用其生成），逗号分隔
UPSTREAM_CHANNELS=playground

# 客户端模型名到目录模型 ID 的映射，每项写成 别名:模型 ID，逗号分隔多项
MODEL_MAPPING=

# 限定模型只走一个上游通道，每项写成 模型 ID:playground 或 模型 ID:build，逗号分隔多项，保存后立即生效
MODEL_CHANNELS=

# 启用 Build 通道时非流式请求先使用 Build 原生单次调用，不可用时回退流式并记录原因
BUILD_NATIVE_NONSTREAM=true

# 非流式请求等待超过 10 秒时先返回 200，之后每 10 秒写出一个换行，经反向代理时连接不会因长时间无数据断开
NONSTREAM_KEEPALIVE=true

# 流式请求先按非流式取得完整结果再按流式格式输出，中途失败时换号重发
FAKE_STREAM=false

# 用户消息文本中的 YouTube 链接作为视频发送给模型
YOUTUBE_LINKS=false

# 以 assistant 消息结尾的请求在不支持原生续写的模型上改写为续写请求；false 时原样发送，上游拒绝时返回其错误
CONTINUATION_REWRITE=true

# 改写时与末尾 assistant 消息一起写入系统指令的续写提示词；设为空时末尾 assistant 消息改作 user 消息发送
CONTINUATION_PROMPT="Continue the assistant response after the following prefix. Return only the continuation, without repeating the prefix."

# 原请求迟迟没有首字时用空闲账户（其他账户优先，没有时用原账户的空闲槽位）发起一个备用请求，先出首字的一方继续：off 关闭，auto 按各模型与通道近 24 小时首字等待的 p95，正整数为等待秒数
FIRST_EVENT_HEDGE=off

# WAA 后端：camoufox 使用 Camoufox 页面，spidermonkey 在服务进程内的 SpiderMonkey 中运行
WAA_BACKEND=camoufox

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false

# Chat Completions 与 Messages 正文中生成媒体的引用方式：inline 以 data URI 内联，url 保存到 runtime/media/ 并以本服务 URL 引用
MEDIA_OUTPUT=inline

# 媒体 URL 使用的服务地址，例如 https://ai.example.com；留空时使用每个请求访问的地址
MEDIA_BASE_URL=
