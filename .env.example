# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 本地 API 认证密钥
PROXY_API_KEY=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=5m

# 常驻预热账户数
WARM_WORKER_LIMIT=5

# 服务启动时同时预热的账户数
WARM_STARTUP_CONCURRENCY=2

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false
